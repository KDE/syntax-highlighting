# Database settings
DB_HOST=localhost
DB_PORT=5432
EMPTY=

export APP_ENV = production
COMPOSE_PROJECT_NAME=my-app
WITH.DOTS=accepted

# Quotes, comments, interpolation, and escapes
PLAIN=value with spaces # trailing comment
HASH=value#comment
SINGLE='literal ${APP_ENV} # text'
DOUBLE="${APP_ENV} with a newline\n"
UNBRACED=$APP_ENV-suffix
MULTILINE="first line
second ${APP_ENV} line"

9INVALID=value
MISSING_SEPARATOR
