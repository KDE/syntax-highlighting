// A complete vertex shader example
struct VertexInput <beginfold id='2'>{</beginfold id='2'>
    @location(0) position: vec3f,
    @location(1) color: vec3f,
<endfold id='2'>}</endfold id='2'>;

struct VertexOutput <beginfold id='2'>{</beginfold id='2'>
    @builtin(position) clip_position: vec4f,
    @location(0) color: vec3f,
<endfold id='2'>}</endfold id='2'>;

@group(0) @binding(0)
var<uniform> model_matrix: mat4x4f;

@vertex
fn vs_main(in: VertexInput) -> VertexOutput <beginfold id='2'>{</beginfold id='2'>
    var out: VertexOutput;
    out.clip_position = model_matrix * vec4f(in.position, 1.0);
    out.color = in.color;
    return out;
<endfold id='2'>}</endfold id='2'>

@fragment
fn fs_main(in: VertexOutput) -> @location(0) vec4f <beginfold id='2'>{</beginfold id='2'>
    return vec4f(in.color, 1.0);
<endfold id='2'>}</endfold id='2'>

// A compute shader example
@group(0) @binding(0)
var<storage, read_write> data: array<f32>;

@compute @workgroup_size(64)
fn cs_main(@builtin(global_invocation_id) id: vec3u) <beginfold id='2'>{</beginfold id='2'>
    let index = id.x;
    data[index] = data[index] * 2.0;
<endfold id='2'>}</endfold id='2'>

// Operators and symbols
let a = 1 + 2 - 3 * 4 / 5 % 6;
let b = (a > 0) && (a < 10) || !(a == 5);
let c = a & 0xFF | 0x0F ^ 0x01;
let d = a << 2;
let e = a >> 1;

// Control flow
if (x > 0) <beginfold id='2'>{</beginfold id='2'>
    y = x;
<endfold id='2'>}</endfold id='2'> else <beginfold id='2'>{</beginfold id='2'>
    y = -x;
<endfold id='2'>}</endfold id='2'>

for (var i = 0; i < 10; i++) <beginfold id='2'>{</beginfold id='2'>
    sum += i;
<endfold id='2'>}</endfold id='2'>

while (x > 0) <beginfold id='2'>{</beginfold id='2'>
    x = x - 1;
<endfold id='2'>}</endfold id='2'>

loop <beginfold id='2'>{</beginfold id='2'>
    if (x <= 0) <beginfold id='2'>{</beginfold id='2'>
        break;
    <endfold id='2'>}</endfold id='2'>
    x = x - 1;
    continuing <beginfold id='2'>{</beginfold id='2'>
        y = y + 1;
    <endfold id='2'>}</endfold id='2'>
<endfold id='2'>}</endfold id='2'>

switch (x) <beginfold id='2'>{</beginfold id='2'>
    case 0: <beginfold id='2'>{</beginfold id='2'>
        y = 1;
    <endfold id='2'>}</endfold id='2'>
    case 1, 2: <beginfold id='2'>{</beginfold id='2'>
        y = 2;
    <endfold id='2'>}</endfold id='2'>
    default: <beginfold id='2'>{</beginfold id='2'>
        y = 0;
    <endfold id='2'>}</endfold id='2'>
<endfold id='2'>}</endfold id='2'>

