<Comment># Database settings</Comment><br/>
<Key>DB_HOST</Key><Assignment>=</Assignment><Value>localhost</Value><br/>
<Key>DB_PORT</Key><Assignment>=</Assignment><Value>5432</Value><br/>
<Key>EMPTY</Key><Assignment>=</Assignment><br/>
<Normal Text></Normal Text><br/>
<Keyword>export</Keyword><Normal Text> </Normal Text><Key>APP_ENV</Key><Normal Text> </Normal Text><Assignment>=</Assignment><Value> production</Value><br/>
<Key>COMPOSE_PROJECT_NAME</Key><Assignment>=</Assignment><Value>my-app</Value><br/>
<Key>WITH.DOTS</Key><Assignment>=</Assignment><Value>accepted</Value><br/>
<Normal Text></Normal Text><br/>
<Comment># Quotes, comments, interpolation, and escapes</Comment><br/>
<Key>PLAIN</Key><Assignment>=</Assignment><Value>value with spaces </Value><Comment># trailing comment</Comment><br/>
<Key>HASH</Key><Assignment>=</Assignment><Value>value</Value><Comment>#comment</Comment><br/>
<Key>SINGLE</Key><Assignment>=</Assignment><String>'literal ${APP_ENV} # text'</String><br/>
<Key>DOUBLE</Key><Assignment>=</Assignment><String>"</String><Variable Expansion>${APP_ENV}</Variable Expansion><String> with a newline</String><Special Character>\n</Special Character><String>"</String><br/>
<Key>UNBRACED</Key><Assignment>=</Assignment><Variable Expansion>$APP_ENV</Variable Expansion><Value>-suffix</Value><br/>
<Key>MULTILINE</Key><Assignment>=</Assignment><String>"first line</String><br/>
<String>second </String><Variable Expansion>${APP_ENV}</Variable Expansion><String> line"</String><br/>
<Normal Text></Normal Text><br/>
<Error>9INVALID=value</Error><br/>
<Error>MISSING_SEPARATOR</Error><br/>
